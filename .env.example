# Use `python manage.py setup` for a local test installation with generated credentials.
# Never commit your actual .env file. Do not enable public collection before review.
APP_ENV=production
PUBLIC_ORIGIN=https://noair.se
SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
DATA_DIR=/data
SUBMISSIONS_ENABLED=0
PRIVACY_REVIEWED=0
PRIVACY_VERSION=pilot-draft-1
# 180 is an initial proposal, not a statutory retention period.
RETENTION_DAYS=180
CONTROLLER_NAME=
CONTROLLER_EMAIL=
LEGAL_BASIS_DESCRIPTION=
PROCESSORS_DESCRIPTION=
BACKUP_POLICY=
SECURITY_LOGS_DESCRIPTION=
# Set to the actual trusted reverse proxy IPs only. Never blindly use *.
FORWARDED_ALLOW_IPS=127.0.0.1

# Public-company contact lookup on the backend (never runs in Pages demo).
CONTACT_LOOKUP_ENABLED=1
# Optional server-only Brave Search connection for news and case studies.
# Set a real key securely in server settings, never in static files or Git.
BRAVE_SEARCH_API_KEY=
# Keep disabled until the deferred eMarketeer server adapter is implemented.
# This flag alone cannot enable sending: the adapter must also be registered.
OUTREACH_MAIL_ENABLED=0
OUTREACH_FROM_EMAIL=Marcus.gustafsson@boxon.com
OUTREACH_FROM_NAME=Boxon
